rules_version = '2';

// ============================================================
//  Crochet Amal — قواعد أمان Firebase Storage
//  انسخي محتوى هذا الملف في:
//  Firebase Console ← Storage ← Rules ← Publish
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    // قراءة الصور للجميع (المتجر يعرضها)
    match /products/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 6 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
